generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId   String      @id
  email    String      @unique
  password String
  roles    String[]
  tokens   AuthToken[]
  bookings Booking[]
}

model AuthToken {
  accessToken  String   @id
  refreshToken String
  userId       String
  roles        String[]
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [userId])
}

model FlightOffer {
  offerId            String         @id
  flightId           String
  cabinClass         String
  availableSeats     Int
  basePriceAmount    Decimal        @db.Decimal(12, 2)
  basePriceCurrency  String
  totalPriceAmount   Decimal        @db.Decimal(12, 2)
  totalPriceCurrency String
  segments           Json
  fareRules          Json
  baggageOptions     Json
  inventory          SeatInventory?
  priceRule          PriceRule?
}

model SeatInventory {
  offerId        String      @id
  availableSeats Int
  offer          FlightOffer @relation(fields: [offerId], references: [offerId])
  holds          SeatHold[]
}

model SeatHold {
  seatHoldId String        @id
  offerId    String
  seatsHeld  Int
  heldUntil  DateTime
  status     String
  inventory  SeatInventory @relation(fields: [offerId], references: [offerId])
}

model PriceRule {
  offerId           String      @id
  basePriceAmount   Decimal     @db.Decimal(12, 2)
  basePriceCurrency String
  offer             FlightOffer @relation(fields: [offerId], references: [offerId])
}

model PromoCode {
  code             String  @id
  discountFraction Decimal @db.Decimal(5, 4)
}

model Passenger {
  passengerId       String             @id
  type              String
  firstName         String
  lastName          String
  birthDate         String
  document          Json?
  specialRequests   Json?
  bookingPassengers BookingPassenger[]
}

model BookingPassenger {
  bookingId   String
  passengerId String
  booking     Booking   @relation(fields: [bookingId], references: [bookingId])
  passenger   Passenger @relation(fields: [passengerId], references: [passengerId])

  @@id([bookingId, passengerId])
}

model Booking {
  bookingId          String             @id
  userId             String
  offerId            String
  status             String
  totalPriceAmount   Decimal            @db.Decimal(12, 2)
  totalPriceCurrency String
  contactInfo        Json
  createdAt          DateTime           @default(now())
  expiresAt          DateTime?
  user               User               @relation(fields: [userId], references: [userId])
  bookingPassengers  BookingPassenger[]
  payments           Payment[]
  tickets            Ticket[]
  notifications      NotificationLog[]
}

model Payment {
  paymentId      String   @id
  bookingId      String
  method         String
  amountValue    Decimal  @db.Decimal(12, 2)
  amountCurrency String
  status         String
  redirectUrl    String?
  createdAt      DateTime @default(now())
  booking        Booking  @relation(fields: [bookingId], references: [bookingId])
}

model Ticket {
  ticketId     String   @id
  bookingId    String
  passengerId  String
  ticketNumber String   @unique
  status       String
  issuedAt     DateTime @default(now())
  booking      Booking  @relation(fields: [bookingId], references: [bookingId])
}

model TicketCounter {
  id        Int @id @default(1)
  nextValue Int @default(1)
}

model NotificationLog {
  notificationId String   @id
  bookingId      String?
  paymentId      String?
  channel        String
  status         String
  sentAt         DateTime @default(now())
  booking        Booking? @relation(fields: [bookingId], references: [bookingId])
}
